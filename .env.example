# =====================================================================
# CropLedger environment template
#
#   cp .env.example .env
#
# .env is gitignored. NEVER commit real values.
#
# Variables prefixed with VITE_ are bundled into the browser app and are
# therefore PUBLIC. Never put a private key, seed phrase or secret API key
# in a VITE_ variable.
# =====================================================================

# ---------------------------------------------------------------------
# Frontend (public, non-secret)
# ---------------------------------------------------------------------

# Chain the dashboard should use in network mode.
#   80002 = Polygon Amoy testnet
#   31337 = Hardhat local node (npm run node)
# Any other chain ID is refused by the app (prevents accidental mainnet use).
VITE_CHAIN_ID=80002

# Address of YOUR deployed CropLedger contract (copy it from Remix after
# deployment). Leave empty to start in local demonstration mode.
# You can also paste the address at runtime in System Configuration.
VITE_CONTRACT_ADDRESS=

# Read-only JSON-RPC endpoint used by the dashboard for queries.
# Use a PUBLIC endpoint here. If you use a keyed provider URL, restrict the
# key to your domain in the provider dashboard, because it is visible in the browser.
VITE_RPC_URL=https://rpc-amoy.polygon.technology

# Block number in which the contract was deployed (optional; speeds up
# event scans). Copy it from the deployment transaction on the explorer.
VITE_DEPLOY_BLOCK=

# ---------------------------------------------------------------------
# Server-side only (Hardhat scripts and the Node gateway). NOT bundled.
# Prefer the encrypted Hardhat keystore for private keys:
#   npx hardhat keystore set DEPLOYER_PRIVATE_KEY
# ---------------------------------------------------------------------

# RPC endpoint used by Hardhat for --network amoy
AMOY_RPC_URL=https://rpc-amoy.polygon.technology

# Private key of a TESTNET-ONLY deployer account (optional; only needed for
# `npm run deploy:amoy`; Remix deployment does not need it).
DEPLOYER_PRIVATE_KEY=

# Private key of a TESTNET-ONLY account used by the Node gateway CLI to pay
# gas when relaying readings to Amoy (optional).
GATEWAY_PRIVATE_KEY=

# Address that should own the contract when deployed with the scripts
# (usually your MetaMask address).
OWNER_ADDRESS=

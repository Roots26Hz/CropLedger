{
  "name": "cropledger",
  "version": "1.0.0",
  "private": true,
  "description": "An end-to-end blockchain application for recording, authenticating, and verifying crop-field sensor readings using Solidity, React, MetaMask, and the Polygon Amoy testnet.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.12.0",
    "npm": ">=10"
  },
  "workspaces": [
    "frontend"
  ],
  "scripts": {
    "compile": "hardhat build",
    "test:contracts": "hardhat test mocha",
    "node": "hardhat node --network localNode",
    "export-abi": "hardhat build && tsx scripts/export-abi.ts",
    "test:unit": "vitest run",
    "test": "npm run test:contracts && npm run test:unit",
    "sim": "tsx simulator/cli.ts",
    "deploy:local": "hardhat run scripts/deploy-local.ts",
    "fund:local": "tsx scripts/fund-local.ts",
    "deploy:amoy": "hardhat run scripts/deploy-testnet.ts",
    "dev": "npm run dev -w frontend",
    "build": "npm run build -w frontend",
    "preview": "npm run preview -w frontend",
    "typecheck": "hardhat build && tsc -p tsconfig.json && npm run typecheck -w frontend",
    "lint": "eslint .",
    "abi:check": "hardhat build && tsx scripts/export-abi.ts --check",
    "flatten": "hardhat flatten contracts/CropLedger.sol > CropLedger.flat.sol"
  },
  "dependencies": {
    "@openzeppelin/contracts": "5.6.1"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@nomicfoundation/hardhat-ethers": "4.2.1",
    "@nomicfoundation/hardhat-ethers-chai-matchers": "3.0.13",
    "@nomicfoundation/hardhat-network-helpers": "3.0.12",
    "@nomicfoundation/hardhat-toolbox-mocha-ethers": "4.0.0",
    "@types/chai": "5.2.3",
    "@types/chai-as-promised": "8.0.2",
    "@types/mocha": "10.0.10",
    "@types/node": "24.19.2",
    "chai": "6.2.2",
    "eslint": "10.13.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "ethers": "6.17.0",
    "globals": "17.13.0",
    "hardhat": "3.20.0",
    "mocha": "12.0.0",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.2",
    "vitest": "5.0.5"
  }
}
